# ==============================================================================
# J BEAUTY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('production' enforces HTTPS cookies and strict MFA)
NODE_ENV=production

# Network Bindings
HOST=0.0.0.0
PORT=3000
OPS_PORT=3100

# Authoritative Persistent Database Path
DB_PATH=data/jspa.sqlite

# Staff MFA Policy ('all' requires mandatory RFC 6238 TOTP for all staff roles)
OPS_MFA_REQUIRED=all

# 32-Byte Hex Encryption Key for TOTP Secrets at rest (Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
OPS_MFA_SECRET_KEY=

# Public Origin URLs (Must match reverse proxy / domain routing)
# Customer Website: https://jbeauty.sa (or http://localhost:3000 for local production)
CUSTOMER_ORIGIN=https://jbeauty.sa
PUBLIC_ORIGIN=https://jbeauty.sa

# Operations & Staff Portal: https://ops.jbeauty.sa (or http://localhost:3100 for local production)
OPS_ORIGIN=https://ops.jbeauty.sa

# Business Operations Settings
BUSINESS_PHONE=966500000000
OWNER_NAME="Owner Name"
OWNER_PHONE="0500000000"
OWNER_PASSWORD=""
