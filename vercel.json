{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/*.mjs": {
      "runtime": "nodejs22.x",
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/ops", "destination": "/apps/staff/index.html" },
    { "source": "/ops/(.*)", "destination": "/apps/staff/$1" },
    { "source": "/ar/ops", "destination": "/apps/staff/index.html" },
    { "source": "/en/ops", "destination": "/apps/staff/index.html" },
    { "source": "/ar/ops/(.*)", "destination": "/apps/staff/$1" },
    { "source": "/en/ops/(.*)", "destination": "/apps/staff/$1" },
    { "source": "/shared/(.*)", "destination": "/shared/$1" },
    { "source": "/(ar|en)/?(.*)", "destination": "/index.html" }
  ]
}
