{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/ar",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/en",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/ops/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://jbeauty-production.up.railway.app/api/$1" },
    { "source": "/ops", "destination": "/ops/index.html" },
    { "source": "/ops/", "destination": "/ops/index.html" },
    { "source": "/ops.css", "destination": "/ops/ops.css" },
    { "source": "/ops-app.js", "destination": "/ops/ops-app.js" },
    { "source": "/ops-state.js", "destination": "/ops/ops-state.js" },
    { "source": "/views/:path*", "destination": "/ops/views/:path*" },
    { "source": "/ops/views/:path*", "destination": "/ops/views/:path*" },
    { "source": "/ops/:path*", "destination": "/ops/:path*" },
    { "source": "/ar/ops", "destination": "/ops/index.html" },
    { "source": "/ar/ops/", "destination": "/ops/index.html" },
    { "source": "/en/ops", "destination": "/ops/index.html" },
    { "source": "/en/ops/", "destination": "/ops/index.html" },
    { "source": "/ar/ops/:path*", "destination": "/ops/index.html" },
    { "source": "/en/ops/:path*", "destination": "/ops/index.html" },
    { "source": "/shared/:path*", "destination": "/shared/:path*" },
    { "source": "/ar", "destination": "/index.html" },
    { "source": "/ar/:path*", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" }
  ]
}
